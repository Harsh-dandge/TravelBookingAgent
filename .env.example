# Environment Variables for Travel Assistant

# REQUIRED: SerpAPI Key for flight, hotel, and event searches
# Get free key at: https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Optional: Flask Configuration
FLASK_ENV=development
DEBUG=True

# Notes:
# - SERPAPI_KEY is required for Flight, Hotel, and Event servers
# - Weather server uses free Open-Meteo API (no key needed)
# - Copy this file to .env and fill in your actual API key
